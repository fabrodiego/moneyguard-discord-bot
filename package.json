{
  "name": "moneyguard-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "D7 - bot do Discord do MoneyGuard",
  "type": "module",
  "main": "dist/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
